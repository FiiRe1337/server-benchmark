{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FiiRe1337/server-benchmark/raw/main/schema/sb-validate-1.schema.json",
  "title": "sbench Job-Validierung (sb-validate/1)",
  "description": "Ausgabe von 'sbench validate --job'.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "sb-validate/1"
    },
    "ok": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(/([^/~]|~[01])*)*$",
            "description": "JSON Pointer (RFC 6901) auf das fehlerhafte Feld, z. B. /tests/0/access_specs/1/block_size; \"\" = Wurzel."
          },
          "code": {
            "type": "string",
            "pattern": "^E_[A-Z0-9_]+$"
          },
          "msg": {
            "type": "string",
            "description": "Menschenlesbare Meldung (Deutsch)."
          }
        },
        "required": [
          "path",
          "code",
          "msg"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "description": "Hinweise, die ok nicht beeinflussen (seit Vertrag 1.1; sbench gibt das Feld immer aus).",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(/([^/~]|~[01])*)*$",
            "description": "JSON Pointer (RFC 6901)."
          },
          "code": {
            "type": "string",
            "pattern": "^W_[A-Z0-9_]+$",
            "description": "Bekannte Codes: W_NEEDS_ADMIN, W_DESTRUCTIVE, W_LOW_DISK_SPACE; weitere W_-Codes dürfen ergänzt werden."
          },
          "msg": {
            "type": "string",
            "description": "Menschenlesbare Meldung (Deutsch)."
          }
        },
        "required": [
          "path",
          "code",
          "msg"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "ok",
    "errors"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "ok": {
        "const": true
      }
    }
  },
  "then": {
    "properties": {
      "errors": {
        "maxItems": 0
      }
    }
  },
  "else": {
    "properties": {
      "errors": {
        "minItems": 1
      }
    }
  }
}
