{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FiiRe1337/server-benchmark/raw/main/schema/sb-progress-1.schema.json",
  "title": "sbench Fortschritts-Event (sb-progress/1)",
  "description": "Ein Event pro Zeile (JSON Lines, UTF-8, LF). Jede Zeile wird einzeln gegen dieses Schema validiert.",
  "oneOf": [
    {
      "type": "object",
      "description": "Lauf beginnt.",
      "properties": {
        "ev": {
          "const": "start"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "tests": {
          "type": "integer",
          "minimum": 1,
          "description": "Anzahl Tests im Job."
        }
      },
      "required": [
        "ev",
        "run_id",
        "tests"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "Phasenwechsel eines Tests.",
      "properties": {
        "ev": {
          "const": "phase"
        },
        "test": {
          "type": "integer",
          "minimum": 0,
          "description": "Testindex."
        },
        "name": {
          "enum": [
            "preparing",
            "warmup",
            "measure",
            "cleanup"
          ]
        },
        "duration_s": {
          "type": "number",
          "minimum": 0,
          "description": "Geplante Dauer der Phase in Sekunden, falls bekannt."
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "description": "Vertrag 1.3, nur im ersten phase-Event eines Tests (preparing): Anzahl Threads (cpu/memory, auch bei threads = 0 im Job bereits aufgelöst) bzw. Worker (storage)."
        },
        "cpus": {
          "type": "array",
          "description": "Vertrag 1.3, nur cpu/memory, nur im ersten phase-Event eines Tests (preparing): gebundener logischer Prozessor je Thread, Reihenfolge = Thread-id (= tick.workers[].id, per_worker[].id). Storage-Worker sind nicht gebunden (kein cpus).",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0,
                "description": "Thread-Index."
              },
              "cpu": {
                "type": "integer",
                "minimum": 0,
                "description": "Globaler Index (Prozessorgruppe × 64 + number) wie meta.numa_nodes[].cpus."
              },
              "group": {
                "type": "integer",
                "minimum": 0,
                "description": "Prozessorgruppe."
              },
              "number": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63,
                "description": "Nummer innerhalb der Prozessorgruppe."
              },
              "numa_node": {
                "type": "integer",
                "minimum": 0,
                "description": "NUMA-Knoten des Prozessors."
              },
              "core": {
                "type": "integer",
                "minimum": 0,
                "description": "Laufende Nummer des physischen Kerns (gleicher Wert = SMT-Geschwister), gültig innerhalb des Laufs."
              },
              "smt_sibling_of": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "description": "Globaler Index des ersten logischen Prozessors desselben Kerns, null für diesen selbst (bzw. ohne SMT)."
              }
            },
            "required": [
              "id",
              "cpu",
              "group",
              "number",
              "numa_node",
              "core",
              "smt_sibling_of"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ev",
        "test",
        "name"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "Fortschritt während preparing/warmup, etwa einmal pro Sekunde.",
      "properties": {
        "ev": {
          "const": "progress"
        },
        "test": {
          "type": "integer",
          "minimum": 0,
          "description": "Testindex."
        },
        "phase": {
          "enum": [
            "preparing",
            "warmup"
          ]
        },
        "done": {
          "type": "number",
          "minimum": 0,
          "description": "Erledigte Menge."
        },
        "total": {
          "type": "number",
          "minimum": 0,
          "description": "Gesamtmenge."
        },
        "unit": {
          "enum": [
            "bytes",
            "s"
          ],
          "description": "bytes = z. B. angelegte Testdatei, s = Sekunden."
        }
      },
      "required": [
        "ev",
        "test",
        "phase",
        "done",
        "total",
        "unit"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "Zwischenwerte des letzten Tick-Intervalls (nur in der Phase measure). Storage-Ticks enthalten immer iops, mbps, lat_us und cpu_pct; cpu-Ticks ops_per_s, memory-Ticks gbps (bandwidth) bzw. latency_ns (latency), jeweils mit cpu_pct und proc_cpu_pct. Ab Vertrag 1.3 nennt metric den Hauptwert, cpu-Ticks tragen score. workers[] enthält jeden Worker/Thread genau einmal, aufsteigend nach id; die Werte sind Raten im Intervall (pro Sekunde, nicht Summen). memory latency hat kein workers[] (immer ein Thread = Gesamtwert).",
      "properties": {
        "ev": {
          "const": "tick"
        },
        "test": {
          "type": "integer",
          "minimum": 0,
          "description": "Testindex."
        },
        "t": {
          "type": "number",
          "minimum": 0,
          "description": "Sekunden seit Beginn der Messphase."
        },
        "metric": {
          "enum": [
            "iops",
            "ops_per_s",
            "gbps",
            "latency_ns",
            "mbps"
          ],
          "description": "Vertrag 1.3, immer ausgegeben: Name des Hauptwerts dieses Ticks (storage iops, cpu ops_per_s, memory bandwidth gbps, memory latency latency_ns, net_* mbps); das gleichnamige Feld ist vorhanden."
        },
        "iops": {
          "type": "number",
          "minimum": 0
        },
        "mbps": {
          "type": "number",
          "minimum": 0,
          "description": "storage: MB/s; net_*: Mbit/s."
        },
        "lat_us": {
          "type": "object",
          "description": "Latenz im Tick-Intervall.",
          "properties": {
            "mean": {
              "type": "number",
              "minimum": 0
            },
            "p50": {
              "type": "number",
              "minimum": 0
            },
            "p99": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "mean",
            "p50",
            "p99",
            "max"
          ],
          "additionalProperties": false
        },
        "read_iops": {
          "type": "number",
          "minimum": 0
        },
        "write_iops": {
          "type": "number",
          "minimum": 0
        },
        "read_mbps": {
          "type": "number",
          "minimum": 0,
          "description": "MB/s"
        },
        "write_mbps": {
          "type": "number",
          "minimum": 0,
          "description": "MB/s"
        },
        "cpu_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Systemlast: alle logischen Prozessoren, 0-100 %."
        },
        "proc_cpu_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "CPU-Last des sbench-Prozesses in Prozent der gesamten Maschine (gleiche Skala wie cpu_pct, 100 = alle logischen Prozessoren voll)."
        },
        "ops_per_s": {
          "type": "number",
          "minimum": 0,
          "description": "cpu: Operationen pro Sekunde."
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "description": "Vertrag 1.3, nur cpu: Score des Intervalls = ops_per_s / meta.cpu_score.ref_ops_per_s[workload] × 1000."
        },
        "gbps": {
          "type": "number",
          "minimum": 0,
          "description": "memory: GB/s."
        },
        "latency_ns": {
          "type": "number",
          "minimum": 0,
          "description": "memory latency: ns pro Zugriff."
        },
        "workers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0
              },
              "iops": {
                "type": "number",
                "minimum": 0
              },
              "mbps": {
                "type": "number",
                "minimum": 0
              },
              "lat_us": {
                "type": "object",
                "properties": {
                  "mean": {
                    "type": "number",
                    "minimum": 0
                  },
                  "p99": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "mean",
                  "p99"
                ],
                "additionalProperties": false
              },
              "ops_per_s": {
                "type": "number",
                "minimum": 0
              },
              "gbps": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ev",
        "test",
        "t"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "Fehler oder Warnung.",
      "properties": {
        "ev": {
          "const": "error"
        },
        "code": {
          "type": "string",
          "pattern": "^E_[A-Z0-9_]+$"
        },
        "msg": {
          "type": "string"
        },
        "field": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$",
          "description": "JSON Pointer auf das betroffene Job-Feld."
        },
        "test": {
          "type": "integer",
          "minimum": 0,
          "description": "Testindex, falls zuordenbar."
        }
      },
      "required": [
        "ev",
        "code",
        "msg"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "Lauf beendet; immer das letzte Event.",
      "properties": {
        "ev": {
          "const": "done"
        },
        "result": {
          "type": "string",
          "minLength": 1,
          "description": "Pfad der geschriebenen Ergebnisdatei."
        },
        "aborted": {
          "type": "boolean",
          "description": "Wie aborted im Ergebnis: true nur bei Stopp (Exit 3), ab Vertrag 1.3.1 bei Laufzeitfehler (Exit 1) false."
        },
        "exit_code": {
          "enum": [
            0,
            1,
            2,
            3,
            4
          ],
          "description": "Vertrag 1.3.1, optional: Exit-Code, mit dem sbench gleich endet (0 ok, 1 Laufzeitfehler, 3 Stopp; 2 und 4 kommen ohne Ergebnis nicht im done-Event vor). 3 genau bei aborted: true; 1 bei einem Laufzeitfehler (Ergebnis mit errors[].fatal)."
        }
      },
      "required": [
        "ev",
        "result",
        "aborted"
      ],
      "additionalProperties": false
    }
  ]
}
