{
  "schema": "sb-job/1",
  "name": "Gemischter Job mit Lücken (net_client und hyperv_info noch nicht implementiert)",
  "tests": [
    {
      "type": "net_client",
      "name": "Netz zu 10.0.0.20",
      "host": "10.0.0.20",
      "duration_s": 30
    },
    {
      "type": "storage",
      "name": "OLTP-ähnlicher Mix",
      "targets": [
        {
          "path": "D:\\sbench\\testfile.dat",
          "kind": "file",
          "file_size": "16GiB"
        },
        {
          "path": "\\\\.\\PhysicalDrive2",
          "kind": "physical",
          "allow_destructive": true
        }
      ],
      "workers": 4,
      "queue_depth": 32,
      "warmup_s": 10,
      "duration_s": 60,
      "cache": "unbuffered",
      "access_specs": [
        {
          "name": "4K random read",
          "weight": 60,
          "block_size": "4KiB",
          "read_pct": 100,
          "random_pct": 100,
          "align": "4KiB"
        },
        {
          "name": "64K seq write",
          "weight": 40,
          "block_size": "64KiB",
          "read_pct": 0,
          "random_pct": 0,
          "align": "64KiB"
        }
      ]
    },
    {
      "type": "hyperv_info",
      "include_perfcounters": true,
      "sample_s": 5
    },
    {
      "type": "storage",
      "name": "OLTP-ähnlicher Mix",
      "targets": [
        {
          "path": "D:\\sbench\\testfile.dat",
          "kind": "file",
          "file_size": "16GiB"
        },
        {
          "path": "\\\\.\\PhysicalDrive2",
          "kind": "physical",
          "allow_destructive": true
        }
      ],
      "workers": 4,
      "queue_depth": 32,
      "warmup_s": 10,
      "duration_s": 60,
      "cache": "unbuffered",
      "access_specs": [
        {
          "name": "4K random read",
          "weight": 60,
          "block_size": "4KiB",
          "read_pct": 100,
          "random_pct": 100,
          "align": "4KiB"
        },
        {
          "name": "64K seq write",
          "weight": 40,
          "block_size": "64KiB",
          "read_pct": 0,
          "random_pct": 0,
          "align": "64KiB"
        }
      ]
    }
  ]
}
