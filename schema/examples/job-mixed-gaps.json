{
  "schema": "sb-job/1",
  "name": "Gemischter Job mit Lücken (cpu/memory noch nicht implementiert)",
  "tests": [
    {
      "type": "cpu",
      "name": "CPU gemischt",
      "threads": 0,
      "workload": "mixed",
      "duration_s": 30
    },
    {
      "type": "storage",
      "name": "OLTP-ähnlicher Mix",
      "targets": [
        {
          "path": "D:\\sbench\\testfile.dat",
          "kind": "file",
          "file_size": "16GiB"
        },
        {
          "path": "\\\\.\\PhysicalDrive2",
          "kind": "physical",
          "allow_destructive": true
        }
      ],
      "workers": 4,
      "queue_depth": 32,
      "warmup_s": 10,
      "duration_s": 60,
      "cache": "unbuffered",
      "access_specs": [
        {
          "name": "4K random read",
          "weight": 60,
          "block_size": "4KiB",
          "read_pct": 100,
          "random_pct": 100,
          "align": "4KiB"
        },
        {
          "name": "64K seq write",
          "weight": 40,
          "block_size": "64KiB",
          "read_pct": 0,
          "random_pct": 0,
          "align": "64KiB"
        }
      ]
    },
    {
      "type": "memory",
      "mode": "bandwidth",
      "op": "copy",
      "threads": 0,
      "buffer_size": "256MiB",
      "duration_s": 20
    },
    {
      "type": "storage",
      "name": "OLTP-ähnlicher Mix",
      "targets": [
        {
          "path": "D:\\sbench\\testfile.dat",
          "kind": "file",
          "file_size": "16GiB"
        },
        {
          "path": "\\\\.\\PhysicalDrive2",
          "kind": "physical",
          "allow_destructive": true
        }
      ],
      "workers": 4,
      "queue_depth": 32,
      "warmup_s": 10,
      "duration_s": 60,
      "cache": "unbuffered",
      "access_specs": [
        {
          "name": "4K random read",
          "weight": 60,
          "block_size": "4KiB",
          "read_pct": 100,
          "random_pct": 100,
          "align": "4KiB"
        },
        {
          "name": "64K seq write",
          "weight": 40,
          "block_size": "64KiB",
          "read_pct": 0,
          "random_pct": 0,
          "align": "64KiB"
        }
      ]
    }
  ]
}
